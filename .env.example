# devin-openai-shim configuration
# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets.
# Loaded automatically by `npm start` (node --env-file-if-exists).

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Default model — used when a request omits `model`. ANY model in the
# account catalog is servable: the first request for a model lazily spawns
# its own `devin acp --model <id>` process (sessions are per process).
# Verify what's available: `devin models list --format json` or GET /v1/catalog.
# Default: swe-2-high
DEVIN_MODEL=swe-2-high

# Transport backend.
#   acp   — one long-lived `devin acp` process (JSON-RPC/stdio). Real SSE
#           streaming + persistent multi-turn sessions. Default & recommended.
#   print — spawn `devin -p` per request. Stateless, fake single-chunk stream.
#           Fallback if ACP misbehaves on your install.
# Default: acp
TRANSPORT=acp

# Absolute path (or command name) for the devin binary. Only needed for
# nonstandard installs — the shim auto-detects at startup:
#   Windows     → Devin Desktop's bundled CLI (via %LOCALAPPDATA%), then PATH
#   macOS/Linux → `devin` on PATH
# The shim exits with a clear error if no CLI is found.
# DEVIN_BIN=C:\path\to\devin.exe

# Permission profile (devin-<profile>.json):
#   safe     — local machine read-only (exec/edit/Write denied) but remote
#              tools allowed: MCP servers (Directus/CMS actions), web_search,
#              fetch/browse. Default & recommended.
#   readonly — denies all of the above too → pure respond-only, no actions.
# SHIM_CONFIG=safe

# Agent persona per session. `smart` (default) exposes tools incl. MCP;
# `ask` is Q&A-only — no tools, so remote actions are impossible in it.
# Others: accept-edits, plan, bypass.
# ACP_MODE=smart

# Workspace root for sessions (the cwd the agent persona may mention).
# Defaults to a neutral temp dir.
# ACP_CWD=C:\path\to\workspace

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Bind port and host. Keep 127.0.0.1 — this service spawns an agent and must
# not be exposed to a network without real hardening.
# Defaults: PORT=8787, HOST=127.0.0.1
PORT=8787
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# API key(s) clients must send as `Authorization: Bearer <key>` on every
# request (OpenAI-style). When unset, the shim is open to anything that can
# reach the port — acceptable only because it binds to localhost.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# Multiple keys — either form (they combine):
#   SHIM_API_KEY=alice:<keyA>,bob:<keyB>        # comma-separated name:key
#   SHIM_API_KEY_ALICE=<keyA>                   # one per line, name from suffix
# Names identify callers in the `[access]` log and GET /v1/access.
# SHIM_API_KEY=
# SHIM_API_KEY_MAIN=
# SHIM_API_KEY_DIRECTUS=

# Optional embeddings upstream. The Devin CLI has no embedding model, so
# POST /v1/embeddings proxies to EMBEDDINGS_UPSTREAM when set (any
# OpenAI-compatible endpoint, e.g. Ollama). Unset → endpoint returns 501.
# EMBEDDINGS_UPSTREAM=http://127.0.0.1:11434/v1
# EMBEDDINGS_KEY=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Per-request timeout in ms. Applies to `devin -p` runs and to each ACP
# JSON-RPC call (including a full prompt turn).
# Default: 480000 (8 min)
DEVIN_TIMEOUT_MS=480000

# Parallel `devin -p` processes allowed (print transport only). Excess
# requests wait in an in-memory queue. ACP transport multiplexes sessions
# over one process and ignores this.
# Default: 2
MAX_CONCURRENT=2

# Idle lifetime of an ACP conversation session in ms. Sessions idle longer
# than this are dropped; the next request starts a fresh conversation.
# Default: 1800000 (30 min)
SESSION_TTL_MS=1800000

# When a spawned `devin` reports "Not logged in", the shim launches
# `devin auth login` in a new console window on your desktop (the login
# flow is interactive and can't be driven headlessly), debounced to one
# window per 60s. Set to 0 to get plain errors instead.
# Default: 1 (Windows only — other platforms log a warning)
# DEVIN_AUTO_LOGIN=1
